# Copy this file's contents into Vercel's Project Settings -> Environment
# Variables (not into a committed .env file). See README.md for the
# step-by-step walkthrough.

# The email address you want deal alerts sent to. This should be the SAME
# address you sign up to Resend with (see README) - the free Resend
# sender can only deliver to your own account's email.
NOTIFY_EMAIL=you@example.com

# From https://resend.com/api-keys after creating a free Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional. Leave this blank unless you want to lock down the endpoint
# so only Vercel's own cron scheduler can trigger it. If you set a value
# here, set the identical value in Vercel's environment variables too.
CRON_SECRET=
